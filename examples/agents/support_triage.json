{
  "name": "support-triage",
  "description": "Route a support ticket, then say what should happen to it",
  "max_steps": 2,
  "graph": {
    "start": "triage",
    "nodes": {
      "triage": {
        "question": {
          "type": "choice",
          "instructions": "Which team should handle this ticket?",
          "options": {
            "billing": "Charges, invoices and refunds",
            "technical": "Faults, errors and outages",
            "account": "Sign-in, passwords and profile changes"
          }
        },
        "edges": {"billing": "refund", "technical": "outage", "account": "identity"},
        "min_probability": 0.45,
        "min_evidence": 0.2,
        "fallback": "human",
        "comment": "an unsure route is a route: it goes to a person"
      },
      "refund": {
        "question": {"type": "bool", "instructions": "Is the customer asking for money back?"},
        "edges": {"yes": "amount", "no": "reply"}
      },
      "amount": {
        "question": {
          "type": "score",
          "instructions": "How large is the amount in dispute?",
          "levels": ["Under 50", "Between 50 and 500", "Over 500"]
        },
        "edges": {"0": "small_refund", "1": "small_refund", "2": "human"},
        "default": "human"
      },
      "outage": {
        "question": {
          "type": "bool",
          "instructions": "Does this describe an outage affecting several people?"
        },
        "edges": {"yes": "page", "no": "reply"}
      },
      "identity": {
        "question": {"type": "bool", "instructions": "Does the customer need help signing in?"},
        "edges": {"yes": "reset", "no": "reply"}
      },
      "small_refund": {"outcome": "issue_refund"},
      "page": {"outcome": "page_oncall"},
      "reset": {"outcome": "reset_access"},
      "reply": {"outcome": "reply"},
      "human": {"outcome": "human_review"}
    }
  },
  "actions": {
    "issue_refund": {"action": "refund", "arguments": {"queue": "billing", "limit": 500}},
    "page_oncall": {"action": "page", "arguments": {"rota": "infrastructure"}},
    "reset_access": {"action": "reset_password", "arguments": {}},
    "reply": {"action": "draft_reply", "arguments": {}},
    "human_review": {"action": "escalate", "arguments": {"reason": "the model was not sure"}}
  }
}
